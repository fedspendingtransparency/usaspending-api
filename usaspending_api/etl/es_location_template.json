{
  "settings": {
    "index.mapping.ignore_malformed": true,
    "index.max_result_window": null,
    "index.refresh_interval": -1,
    "index": {
      "number_of_shards": 5,
      "number_of_replicas": 0
    },
    "analysis": {
      "normalizer": {
        "uppercase_normalizer": {
          "type": "custom",
          "filter": ["uppercase"]
        }
      },
      "analyzer": {
        "contains_analyzer": {
          "type": "custom",
          "tokenizer": "edge_ngram_tokenizer",
          "filter": [
            "uppercase"
          ]
        },
        "whole_string_analyzer": {
          "type": "custom",
          "tokenizer": "keyword",
          "filter": [
            "uppercase"
          ]
        },
        "word_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "uppercase"
          ]
        }
      },
      "tokenizer": {
        "edge_ngram_tokenizer": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 20,
          "token_chars": [
            "letter",
            "digit",
            "whitespace"
          ]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "location": {
        "type": "text",
        "analyzer": "whole_string_analyzer",
        "fields": {
          "contains": {
            "type": "text",
            "analyzer": "contains_analyzer"
          },
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "country_name": {
        "type": "keyword",
        "normalizer": "uppercase_normalizer",
        "copy_to": "location_search"
      },
      "country_code": {
        "type": "keyword",
        "normalizer": "uppercase_normalizer",
        "copy_to": "location_search"
      },
      "state_name": {
        "type": "keyword",
        "normalizer": "uppercase_normalizer",
        "copy_to": "location_search"
      },
      "state_abbreviation": {
        "type": "keyword",
        "normalizer": "uppercase_normalizer",
        "copy_to": "location_search"
      },
      "city_name": {
        "type": "keyword",
        "normalizer": "uppercase_normalizer",
        "copy_to": "location_search"
      },
      "county_name": {
        "type": "keyword",
        "normalizer": "uppercase_normalizer",
        "copy_to": "location_search"
      },
      "zip_code": {
        "type": "keyword",
        "copy_to": "location_search"
      },
      "county_fips": {
        "type": "keyword"
      },
      "congressional_district": {
        "type": "keyword",
        "normalizer": "uppercase_normalizer"
      },
      "location_search": {
        "type": "text",
        "analyzer": "word_analyzer"
      },
      "location_json": {
        "type": "object",
        "enabled": false
      },
      "location_type": {
        "type": "keyword"
      }
    }
  }
}